{
  "name": "mcp-test",
  "version": "0.2.0",
  "description": "Functional + security testing for MCP servers, plus a schema-drift upgrade gate (snapshot + diff)",
  "type": "module",
  "license": "MIT",
  "bin": {
    "mcp-test": "dist/src/cli.js"
  },
  "exports": {
    ".": "./dist/src/index.js"
  },
  "files": [
    "dist",
    "example",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node run-tests.mjs",
    "demo": "node dist/src/cli.js -c example/mcp-test.yaml",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "security-testing",
    "prompt-injection",
    "ci"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhengqiuyang/mcp-test.git"
  }
}
